# ======================================
# REQUIRED
# ======================================

# Anthropic API Configuration (REQUIRED)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ======================================
# OPTIONAL: Email Delivery
# ======================================
# Email is OPTIONAL - reports are always saved to reports/ folder
# Only configure if you want automatic email delivery
# See EMAIL_GUIDE.md for alternatives

# Option 1: Gmail (requires App Password, may not work on Railway)
# See: https://support.google.com/accounts/answer/185833
#SENDER_EMAIL=your-email@gmail.com
#RECIPIENT_EMAIL=recipient@example.com
#EMAIL_PASSWORD=your_gmail_app_password
#SMTP_SERVER=smtp.gmail.com
#SMTP_PORT=465

# Option 2: SendGrid (RECOMMENDED for Railway - free tier available)
# Works better on cloud platforms, see RAILWAY_EMAIL_FIX.md
#SENDGRID_API_KEY=SG.your-sendgrid-api-key
#SENDGRID_FROM_EMAIL=your-verified-email@example.com
#RECIPIENT_EMAIL=recipient@example.com

# ======================================
# OPTIONAL: Slack Integration
# ======================================
# Send reports to Slack instead of email
# See EMAIL_GUIDE.md for setup instructions

#SLACK_TOKEN=xoxb-your-slack-bot-token
#SLACK_CHANNEL=#ai-reports

# Optional: GitHub Integration
SAVE_TO_GITHUB=false
GITHUB_TOKEN=your_github_token

# Application Settings
LOG_LEVEL=INFO
DRY_RUN=false
MAX_REPORTS=25
SEARCH_DAYS_BACK=7

# Testing & Iteration Modes (avoid repeated API costs)
CACHE_MODE=false    # Save API response to cache (run once, costs $3-5)
REPLAY_MODE=false   # Use cached response (unlimited iterations, free)
